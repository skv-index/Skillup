# Copy to .env and adjust.
#
# Supabase project URL (Settings > Connect). Used by src/lib/supabase.ts.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase publishable key (Settings > API Keys > Publishable, sb_publishable_xxx).
# Safe for browser code. Do NOT use the secret key in the frontend.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Direct Postgres connection (server-side only) — used by `npm run db:schema`
# to apply supabase/schema.sql. Never use this in browser code.
DATABASE_URL=postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres

# Alternative to DATABASE_URL — applies schema over HTTPS via the Management API
# (npm run db:schema:mgmt). Only needed if the DB host is unreachable.
# SUPABASE_PROJECT_REF=<project-ref>
# SUPABASE_PAT=sbp_...

# Used by src/lib/api-client.ts
VITE_API_URL=http://localhost:4000/api

# Groq AI key (Part 1 assessments/resume/gaps). DANGER: VITE_* keys ship to the
# browser bundle — fine for demo/dev keys, but rotate to a backend proxy in prod.
VITE_GROQ_API_KEY=gsk_...
# Optional: default model is openai/gpt-oss-120b
# VITE_GROQ_MODEL=openai/gpt-oss-120b